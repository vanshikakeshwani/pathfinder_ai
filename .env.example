# LLM gateway (Experiential Labs)
LLM_PROVIDER=experiential
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_API_KEY=
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# Only sent if the gateway smoke test confirmed support
LLM_TEMPERATURE=0
# json_schema | json_object | prompt  (set from docs/gateway-compat.md after smoke test)
LLM_STRUCTURED_MODE=json_schema

# Research tools (Exa)
EXA_API_KEY=
EXA_REQUEST_TIMEOUT_S=20
EXA_MAX_RETRIES=2

# Research-action budget (fair-comparison unit, always enforced)
MAX_SEARCH_CALLS=6
MAX_CONTENT_PAGES=12
MAX_RESEARCH_ROUNDS=3
MAX_NO_PROGRESS=2
MAX_EVIDENCE_PER_ROUND=12
MAX_INITIAL_QUERIES=2
RESULTS_PER_SEARCH=5
PAGES_PER_SEARCH=2

# Optional caps (empty = disabled)
MAX_LLM_CALLS=
MAX_SECONDS=

OUTPUT_DIR=outputs
