# Optional DEEP-RESEARCH limits for a single `run`. Not used by default, by tests, by the offline demo,
# or by any recorded evaluation (V2, V3 pilots, the V3.2 benchmark), whose budgets are frozen.
# Use them as PROCESS environment variables, which take precedence over .env (see README, "Deep-research mode").
# More research does NOT guarantee a better answer: it costs more and can surface more disagreement.
MAX_RESEARCH_ROUNDS=5
MAX_SEARCH_CALLS=8
MAX_CONTENT_PAGES=16
MAX_LLM_CALLS=20
MAX_SECONDS=360
MAX_NO_PROGRESS=2
